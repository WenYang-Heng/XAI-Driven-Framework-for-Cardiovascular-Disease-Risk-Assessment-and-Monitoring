PORT=8000
NODE_ENV=development

SUPABASE_URL=your_supabase_url
# Use SUPABASE_SECRET_KEY for new Supabase API keys, or SUPABASE_SERVICE_ROLE_KEY for legacy projects.
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Direct Supabase Postgres connection. Use this exact format from Supabase.
DATABASE_URL=postgresql://postgres:your_password@db.akrgcfivegcwhfbertyg.supabase.co:5432/postgres

# Optional fallback if DATABASE_URL is not set.
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=db.akrgcfivegcwhfbertyg.supabase.co
DB_PORT=5432
DB_NAME=postgres

# Supabase's Python connection snippet uses lowercase names; these are also supported.
user=postgres
password=your_password
host=db.akrgcfivegcwhfbertyg.supabase.co
port=5432
dbname=postgres

SERVER_ML_BASE_URL=http://localhost:8001

# Backend-only OpenAI settings for AI-assisted action plans.
# Do not expose these through frontend VITE_* variables.
OPENAI_API_KEY=your_openai_api_key
OPENAI_ACTION_PLAN_MODEL=gpt-4.1-mini
OPENAI_CHATBOT_MODEL=gpt-4.1-mini

# Reminder email notifications. Resend is recommended for the prototype.
RESEND_API_KEY=your_resend_api_key
REMINDER_EMAIL_FROM=CardioXAI <onboarding@resend.dev>
# Optional: if set, POST /api/reminders/process-due requires this value in X-Reminder-Processor-Token.
REMINDER_PROCESSOR_TOKEN=your_internal_processor_token
